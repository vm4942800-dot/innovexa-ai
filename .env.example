# ==============================================================================
# AI INNOVATE LAB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Client-Side)
# ------------------------------------------------------------------------------
# Supabase project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE ENVIRONMENT VARIABLES (Node.js / Express / Edge)
# ------------------------------------------------------------------------------
# Server port
PORT=5000

# Backend Supabase configuration for logging interactions & telemetry
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# (Optional) Supabase Service Role Key for elevated administrative operations
# WARNING: NEVER prefix with VITE_ or expose to client-side bundles!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# (Optional) Google Gemini API Key for direct Gemini Generative Language calls
# If omitted, the backend server seamlessly falls back to high-fidelity heuristic engines
# GEMINI_API_KEY=your-gemini-api-key-here
